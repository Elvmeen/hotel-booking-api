# CodeIgniter system folder — installed via Composer (see composer.json)
system/
vendor/

# Environment and local overrides
.env
application/config/database.local.php

# Logs
application/logs/*.log
!application/logs/index.html

# Cache
application/cache/*
!application/cache/index.html

# Upload folder
uploads/*
!uploads/.gitkeep

# OS files
.DS_Store
Thumbs.db

# IDE files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Node (not used by this project)
node_modules/
package-lock.json
