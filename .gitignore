# CodeIgniter
  system/
  vendor/

  # Environment
  .env
  application/config/database.local.php

  # Logs
  application/logs/*.log
  !application/logs/index.html

  # Cache
  application/cache/*
  !application/cache/index.html

  # Uploads
  uploads/*
  !uploads/.gitkeep

  # OS
  .DS_Store
  Thumbs.db

  # IDE
  .idea/
  .vscode/
  *.sublime-project
  *.sublime-workspace

  # Node / frontend build output
  node_modules/
  package-lock.json
  dist/
  tmp/
  *.tsbuildinfo

  # Replit
  .cache/
  .local/
  